{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "proxy/*.js",
    "scripts/tools/*.{mjs,mts}",
    "scripts/tests/*.{mjs,ts}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,mts,ts}",
    "proxy/*.js"
  ],
  "ignore": [
    "scripts/tests/test-browser-visible.mjs"
  ],
  "ignoreDependencies": [
    "@fontsource/noto-serif-sc"
  ]
}
