const sheets: XlsxSheet[] = [
  {
    name: "题库",
    rows: questionRows,
    rowHeights: questionRows.map((_, index) => index === 6 ? 152 : 0),
    columnWidths: [58, 10, 22, 34, ...Array.from({ length: 4 }, () => 13), ...Array.from({ length: 8 }, () => 22), 28],
  },
  {
    name: "使用说明",
    rows: instructionRows,
    columnWidths: [18, 110],
  },
];

const images: XlsxEmbeddedImage[] = [{
  id: templateImageId,
  bytes: appIcon,
  extension: "png",
  width: 192,
  height: 192,
}];

const outputPath = fileURLToPath(new URL("../../public/题库模板.xlsx", import.meta.url));
await writeFile(outputPath, buildXlsx(sheets, images));
console.log(`题库模板已生成：${outputPath}（含单选、多选、判断、计算、填空、简答和图片题示例）`);
