{
  "name": "exam-study-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:architecture && npm run typecheck && npm run build && npm run test:sync && npm run test:shortcuts && npm run test:press-intent && npm run test:typography",
    "typecheck": "tsc --noEmit",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:sync": "tsx scripts/test-sync-protocol.ts && tsx scripts/test-sync-data-model.ts && tsx scripts/test-sync-entity-conflicts.ts && tsx scripts/test-sync-concurrency.ts && tsx scripts/test-sync-restore.ts",
    "test:shortcuts": "tsx scripts/test-keyboard-shortcuts.ts",
    "test:press-intent": "tsx scripts/test-press-intent.ts",
    "test:typography": "tsx scripts/test-display-typography.ts",
    "lint": "eslint . --ignore-pattern dist"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "katex": "^0.18.2",
    "lucide-react": "^1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
