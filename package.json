{
  "name": "exam-study-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/tools/subset-title-font.mjs",
    "build": "vite build && node scripts/tools/emit-pages-relay.mjs",
    "prebuild": "node scripts/tools/subset-title-font.mjs",
    "relay:pages": "node scripts/tools/emit-pages-relay.mjs",
    "preview": "vite preview",
    "test": "npm run test:architecture && npm run typecheck && npm run build && npm run test:sync && npm run test:pwa && npm run test:shortcuts && npm run test:xlsx && npm run test:press-intent && npm run test:typography && npm run test:answer-ui && npm run test:question-types && npm run test:overview && npm run test:search-filters && npm run test:content-block-ui && npm run test:review-scope-ui && npm run test:v6-ui && npm run test:modal && npm run test:notice-tone",
    "typecheck": "tsc --noEmit",
    "test:architecture": "node scripts/tools/check-architecture.mjs && node scripts/tools/check-no-native-tooltip-titles.mjs",
    "test:notice-tone": "tsx scripts/tests/test-notice-tone.ts",
    "test:sync": "npm run test:sync-payload && npm run test:sync-v7 && npm run test:sync-event-ui && npm run test:v6-domain && npm run test:db-v6 && npm run test:image-assets && npm run test:sync-mock && npm run test:sync-integration && npm run test:sync-progress && npm run test:sync-compression && npm run test:sync-download-concurrency && npm run test:sync-replay-perf && npm run test:sync-install-fingerprint && npm run test:sync-tombstone-gc",
    "test:sync-v7": "npm run test:sync-v7-protocol && npm run test:change-set-v7 && npm run test:sync-v7-multidevice",
    "test:sync-payload": "tsx scripts/tests/test-sync-v7-payload.ts",
    "test:sync-v7-multidevice": "tsx scripts/tests/test-sync-v7-multidevice.ts",
    "test:sync-v7-protocol": "tsx scripts/tests/test-sync-v7-head.ts && tsx scripts/tests/test-github-v7-remote.ts",
    "test:pwa": "tsx scripts/tests/test-pwa-cache.ts",
    "test:relay": "tsx scripts/tests/test-github-relay-consistency.ts",
    "test:shortcuts": "tsx scripts/tests/test-keyboard-shortcuts.ts",
    "test:xlsx": "tsx scripts/tests/test-xlsx-import.ts && tsx scripts/tests/test-xlsx-export.ts && tsx scripts/tests/test-question-images.ts",
    "test:note-markdown": "tsx scripts/tests/test-note-markdown.ts",
    "test:browser": "node scripts/tests/test-browser-visible.mjs",
    "test:browser:desktop": "BROWSER_GROUPS=desktop node scripts/tests/test-browser-visible.mjs",
    "test:browser:mobile": "BROWSER_GROUPS=mobile node scripts/tests/test-browser-visible.mjs",
    "test:browser:management": "BROWSER_GROUPS=management node scripts/tests/test-browser-visible.mjs",
    "test:browser:review": "BROWSER_GROUPS=review node scripts/tests/test-browser-visible.mjs",
    "test:browser:search": "BROWSER_GROUPS=search node scripts/tests/test-browser-visible.mjs",
    "test:browser:history": "BROWSER_GROUPS=history node scripts/tests/test-browser-visible.mjs",
    "test:browser:inflight": "BROWSER_GROUPS=inflight node scripts/tests/test-browser-visible.mjs",
    "test:press-intent": "tsx scripts/tests/test-press-intent.ts",
    "test:typography": "tsx scripts/tests/test-display-typography.ts",
    "test:answer-ui": "tsx scripts/tests/test-practice-answer-feedback.ts",
    "test:question-types": "tsx scripts/tests/test-question-types.ts",
    "test:overview": "tsx scripts/tests/test-question-overview.ts",
    "test:search-filters": "tsx scripts/tests/test-search-filters.ts",
    "test:modal": "tsx scripts/tests/test-modal-layering.ts",
    "test:v6-domain": "tsx scripts/tests/test-v6-domain.ts",
    "test:change-set-v7": "tsx scripts/tests/test-change-set-v7.ts",
    "test:db-v6": "tsx scripts/tests/test-db-v6.ts && tsx scripts/tests/test-app-data-v6.ts",
    "test:image-assets": "tsx scripts/tests/test-image-assets.ts",
    "test:content-block-ui": "tsx scripts/tests/test-content-block-ui.ts",
    "test:review-scope-ui": "tsx scripts/tests/test-review-scope-ui.ts",
    "test:v6-ui": "tsx scripts/tests/test-v6-ui-data-flow.ts",
    "test:sync-event-ui": "tsx scripts/tests/test-sync-event-ui.ts",
    "test:sync-mock": "tsx scripts/tests/test-sync-mock-backend.ts",
    "test:sync-coalescing": "tsx scripts/tests/test-sync-coalescing.ts",
    "test:sync-fault": "tsx scripts/tests/test-sync-fault-tolerance.ts",
    "test:sync-integrity": "tsx scripts/tests/test-sync-integrity.ts",
    "test:sync-integration": "tsx scripts/tests/test-sync-mock-integration.ts && tsx scripts/tests/test-sync-stats-integration.ts && tsx scripts/tests/test-sync-event-management.ts && tsx scripts/tests/test-sync-question-management.ts && tsx scripts/tests/test-sync-coalescing.ts && tsx scripts/tests/test-sync-fault-tolerance.ts && tsx scripts/tests/test-sync-integrity.ts",
    "test:sync-progress": "tsx scripts/tests/test-sync-progress.ts",
    "test:sync-compression": "tsx scripts/tests/test-sync-compression.ts",
    "test:sync-download-concurrency": "tsx scripts/tests/test-sync-download-concurrency.ts",
    "test:sync-replay-perf": "tsx scripts/tests/test-sync-replay-perf.ts",
    "test:sync-install-fingerprint": "tsx scripts/tests/test-sync-install-fingerprint.ts",
    "test:sync-tombstone-gc": "tsx scripts/tests/test-sync-tombstone-gc.ts",
    "migrate:vault": "tsx scripts/tools/migrate-vault-compressed.mts",
    "lint": "eslint . --ignore-pattern dist",
    "test:unit": "node scripts/tools/run-test-groups.mjs unit",
    "test:source": "node scripts/tools/run-test-groups.mjs source",
    "test:integration": "node scripts/tools/run-test-groups.mjs integration",
    "test:fast": "node scripts/tools/run-test-groups.mjs unit source integration typecheck lint",
    "test:ci": "npm run test",
    "test:full": "npm run test && npm run test:browser",
    "template:xlsx": "node scripts/tools/generate-xlsx-template.mjs",
    "test:sync-multidevice-checkpoints": "tsx scripts/tests/test-sync-multidevice-checkpoints.ts"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "katex": "^0.18.2",
    "lucide-react": "^1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "16.4.0",
    "playwright-core": "^1.62.1",
    "subset-font": "^2.5.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "xlsx": "^0.18.5"
  },
  "type": "module"
}
