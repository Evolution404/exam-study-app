{
  "name": "exam-study-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/subset-title-font.mjs",
    "build": "vite build",
    "prebuild": "node scripts/subset-title-font.mjs",
    "preview": "vite preview",
    "test": "npm run test:architecture && npm run typecheck && npm run build && npm run test:sync && npm run test:pwa && npm run test:shortcuts && npm run test:xlsx && npm run test:press-intent && npm run test:typography && npm run test:answer-ui && npm run test:question-types && npm run test:overview && npm run test:search-filters && npm run test:content-block-ui && npm run test:review-scope-ui && npm run test:v6-ui && npm run test:modal && npm run test:notice-tone",
    "typecheck": "tsc --noEmit",
    "test:architecture": "node scripts/check-architecture.mjs",
    "test:notice-tone": "tsx scripts/test-notice-tone.ts",
    "test:sync": "npm run test:sync-payload && npm run test:sync-v7 && npm run test:sync-event-ui && npm run test:v6-domain && npm run test:db-v6 && npm run test:image-assets && npm run test:sync-mock && npm run test:sync-integration",
    "test:sync-v7": "npm run test:sync-v7-protocol && npm run test:change-set-v7 && npm run test:sync-v7-multidevice",
    "test:sync-payload": "tsx scripts/test-sync-v7-payload.ts",
    "test:sync-v7-multidevice": "tsx scripts/test-sync-v7-multidevice.ts",
    "test:sync-v7-protocol": "tsx scripts/test-sync-v7-head.ts && tsx scripts/test-github-v7-remote.ts",
    "test:pwa": "tsx scripts/test-pwa-cache.ts",
    "test:shortcuts": "tsx scripts/test-keyboard-shortcuts.ts",
    "test:xlsx": "tsx scripts/test-xlsx-import.ts",
    "test:browser": "node scripts/test-browser-visible.mjs",
    "test:press-intent": "tsx scripts/test-press-intent.ts",
    "test:typography": "tsx scripts/test-display-typography.ts",
    "test:answer-ui": "tsx scripts/test-practice-answer-feedback.ts",
    "test:question-types": "tsx scripts/test-question-types.ts",
    "test:overview": "tsx scripts/test-question-overview.ts",
    "test:search-filters": "tsx scripts/test-search-filters.ts",
    "test:modal": "tsx scripts/test-modal-layering.ts",
    "test:v6-domain": "tsx scripts/test-v6-domain.ts",
    "test:change-set-v7": "tsx scripts/test-change-set-v7.ts",
    "test:db-v6": "tsx scripts/test-db-v6.ts && tsx scripts/test-app-data-v6.ts",
    "test:image-assets": "tsx scripts/test-image-assets.ts",
    "test:content-block-ui": "tsx scripts/test-content-block-ui.ts",
    "test:review-scope-ui": "tsx scripts/test-review-scope-ui.ts",
    "test:v6-ui": "tsx scripts/test-v6-ui-data-flow.ts",
    "test:sync-event-ui": "tsx scripts/test-sync-event-ui.ts",
    "test:sync-mock": "tsx scripts/test-sync-mock-backend.ts",
    "test:sync-coalescing": "tsx scripts/test-sync-coalescing.ts",
    "test:sync-integration": "tsx scripts/test-sync-mock-integration.ts && tsx scripts/test-sync-stats-integration.ts && tsx scripts/test-sync-event-management.ts && tsx scripts/test-sync-question-management.ts && tsx scripts/test-sync-coalescing.ts",
    "lint": "eslint . --ignore-pattern dist"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.3.7",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "katex": "^0.18.2",
    "lucide-react": "^1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@fontsource/noto-serif-sc": "^5.2.8",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "16.4.0",
    "playwright-core": "^1.62.1",
    "subset-font": "^2.5.0",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "xlsx": "^0.18.5"
  },
  "type": "module"
}
